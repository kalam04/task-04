# Copy to backend/.env and fill in. Never commit the real .env.

PORT=4000
# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# First admin account, created only if it doesn't exist yet. Change the password after the first login.
DEFAULT_USERNAME=admin
DEFAULT_PASSWORD=change-me

# --- Production (optional) ---
# NODE_ENV=production
# Keep the database outside the code folder so deploys never touch it
# DB_PATH=/var/lib/task-management/data.db
# Daily automatic backups (default: a "backups" folder next to the database, keeping the newest 14)
# BACKUP_DIR=/var/backups/task-management
# BACKUP_KEEP=14
# Task attachments: folder for uploaded files (default: an "uploads" folder next to the database)
# and the largest single file allowed, in MB (default 2048 = 2 GB)
# UPLOAD_DIR=/var/lib/task-management/uploads
# MAX_UPLOAD_MB=2048
# Behind Nginx on the same machine
# TRUST_PROXY=true
# Dates such as "overdue" use the server's time zone
# TZ=Asia/Dhaka
